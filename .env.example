# Uygulama
NODE_ENV=development
PORT=5000
PUBLIC_APP_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/benimmarketim
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret

# Yapay zekâ sağlayıcıları (yalnızca seçilen sağlayıcının anahtarı gerekir)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free

# Fotoğraftan ürün ekleme (admin) — ücretsiz kurulum:
# GEMINI_API_KEY: Google AI Studio'da ödeme bağlanmamış bir projeden alınan anahtar (ücretsiz katman)
GEMINI_VISION_MODEL=gemini-flash-latest
# Kendi sunucudaki ücretsiz SearXNG görsel araması (ops/searxng/KURULUM.md)
SEARXNG_URL=http://127.0.0.1:8888
# İsteğe bağlı ücretli görsel arama. Yalnızca açıkça seçilirse kullanılır:
# IMAGE_SEARCH_PROVIDER=firecrawl
# FIRECRAWL_API_KEY=
IMAGE_SEARCH_PROVIDER=searxng

# İsteğe bağlı Socket.IO Redis adapter
UPSTASH_REDIS_URL=
REDIS_DISABLED=true

# OneSignal müşteri sipariş durumu bildirimleri
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Gece veritabanı yedeği (backend/workers/BACKUP.md)
# Parola zorunlu değil ama önerilir: yalnızca şifreli yedekler Telegram'a gönderilir. Parolayı kaybederseniz yedek açılamaz.
BACKUP_PASSWORD=
# Varsayılan: proje içinde backups/ ; sunucuda örn. /var/backups/benimmarketim-db
BACKUP_DIR=
BACKUP_KEEP_DAYS=14
# BACKUP_SCHEDULE=30 3 * * *

# Fiyat bekçisi (backend/workers/PRICE_WATCH.md): SEARXNG_URL ile gece ürünlerin piyasa fiyatını kontrol eder
# PRICE_WATCH_ENABLED=true
# PRICE_WATCH_HOURS=1-7
# PRICE_WATCH_DAILY_LIMIT=300
# PRICE_WATCH_DELAY_SEC=20-30
# PRICE_WATCH_THRESHOLD=20
# PRICE_WATCH_TOP_SELLERS=100

# Camgöz (JoJ API) — fiyat bekçisinin ana kaynağı. Anahtar yoksa yalnızca market sayfaları okunur.
JOJAPI_API_KEY=
# CAMGOZ_MONTHLY_CREDITS=500
# CAMGOZ_MAX_AGE_DAYS=90
# CAMGOZ_MARKETS=A101,Migros,Şok,Carrefour,Hakmar,BİM,File,Macro Center,Tarım Kredi,Bizim Toptan,Mopaş
