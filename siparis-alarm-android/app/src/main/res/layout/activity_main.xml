<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <!-- Üst bant -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_icon_glass"
            android:importantForAccessibility="no"
            android:padding="10dp"
            android:src="@drawable/ic_bell"
            android:tint="@color/lime" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Benim Marketim"
                android:textColor="@color/lime"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Sipariş Alarmı"
                android:textColor="@android:color/white"
                android:textSize="22sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/deviceChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_counter"
            android:drawableStart="@drawable/ic_smartphone"
            android:drawablePadding="6dp"
            android:drawableTint="@color/lime"
            android:ellipsize="end"
            android:maxWidth="180dp"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.benimmarketim.siparisalarm.MaxWidthLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp"
                android:tag="max:600">

                <!-- ══════════ Giriş / eşleme ══════════ -->
                <LinearLayout
                    android:id="@+id/loginSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="4dp">

                        <com.benimmarketim.siparisalarm.PulseView
                            android:id="@+id/loginPulse"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_circle"
                            android:backgroundTint="@color/green"
                            android:importantForAccessibility="no"
                            android:padding="15dp"
                            android:src="@drawable/ic_bell"
                            android:tint="@android:color/white" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans-serif-black"
                        android:gravity="center"
                        android:text="Sipariş gelince telefon çalsın"
                        android:textColor="@color/ink"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="Yönetici hesabınızla bir kez giriş yapın, bu telefon yeni siparişlerde alarm çalsın."
                        android:textColor="@color/muted"
                        android:textSize="15sp" />

                    <LinearLayout style="@style/Card">

                        <TextView
                            style="@style/Label"
                            android:layout_marginTop="0dp"
                            android:text="E-posta" />

                        <EditText
                            android:id="@+id/email"
                            style="@style/Input"
                            android:autofillHints="emailAddress"
                            android:drawableStart="@drawable/ic_email"
                            android:drawablePadding="12dp"
                            android:drawableTint="@color/subtle"
                            android:hint="yonetici@ornek.com"
                            android:inputType="textEmailAddress" />

                        <TextView
                            style="@style/Label"
                            android:text="Şifre" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/password"
                                style="@style/Input"
                                android:autofillHints="password"
                                android:drawableStart="@drawable/ic_lock"
                                android:drawablePadding="12dp"
                                android:drawableTint="@color/subtle"
                                android:hint="Şifreniz"
                                android:inputType="textPassword"
                                android:paddingEnd="56dp" />

                            <ImageView
                                android:id="@+id/passwordToggle"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:layout_gravity="end|center_vertical"
                                android:layout_marginEnd="4dp"
                                android:background="@drawable/bg_link"
                                android:contentDescription="Şifreyi göster"
                                android:padding="12dp"
                                android:src="@drawable/ic_visibility"
                                android:tint="@color/subtle" />
                        </FrameLayout>

                        <TextView
                            style="@style/Label"
                            android:text="Bu telefonun adı" />

                        <EditText
                            android:id="@+id/deviceName"
                            style="@style/Input"
                            android:drawableStart="@drawable/ic_smartphone"
                            android:drawablePadding="12dp"
                            android:drawableTint="@color/subtle"
                            android:hint="Örn. Kasa telefonu"
                            android:inputType="textCapSentences"
                            android:maxLength="40" />

                        <TextView
                            android:id="@+id/serverToggle"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_link"
                            android:gravity="center_vertical"
                            android:paddingStart="4dp"
                            android:paddingEnd="8dp"
                            android:text="Sunucu adresini değiştir"
                            android:textColor="@color/green_dark"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/server"
                            style="@style/Input"
                            android:inputType="textUri"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/loginError"
                            style="@style/Body"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_pill_red_soft"
                            android:drawableStart="@drawable/ic_error"
                            android:drawablePadding="10dp"
                            android:drawableTint="@color/red"
                            android:gravity="center_vertical"
                            android:padding="12dp"
                            android:textColor="@color/red"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/loginButton"
                            style="@style/ButtonPrimary"
                            android:layout_marginTop="16dp"
                            android:text="Giriş yap ve alarmı aç" />
                    </LinearLayout>

                    <!-- Neden güvenli / ne yapar -->
                    <LinearLayout
                        style="@style/Card"
                        android:background="@drawable/bg_pill_green_soft">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/RowIcon"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/surface"
                                android:src="@drawable/ic_lock" />

                            <TextView
                                style="@style/Body"
                                android:text="Kilit ekranında bile çalar, “Gördüm” ya da “Kabul Et” denene kadar susmaz."
                                android:textColor="@color/ink_soft" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/RowIcon"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/surface"
                                android:src="@drawable/ic_shield" />

                            <TextView
                                style="@style/Body"
                                android:text="Şifreniz telefonda saklanmaz. Telefonu yönetim panelinden istediğiniz an kaldırabilirsiniz."
                                android:textColor="@color/ink_soft" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ══════════ Panel ══════════ -->
                <LinearLayout
                    android:id="@+id/dashboardSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Durum (rengi koddan: yeşil / turuncu / kırmızı) -->
                    <LinearLayout
                        android:id="@+id/statusCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.benimmarketim.siparisalarm.PulseView
                                android:id="@+id/statusDot"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:layout_marginEnd="10dp"
                                android:tag="dot" />

                            <TextView
                                android:id="@+id/statusTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@android:color/white"
                                android:textSize="20sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/statusDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/white_70"
                            android:textSize="14sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="12dp"
                            android:background="@color/white_20" />

                        <TextView
                            android:id="@+id/deviceLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:textColor="@color/white_70"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Onay bekleyen siparişler -->
                    <LinearLayout
                        android:id="@+id/pendingCard"
                        style="@style/Card"
                        android:background="@drawable/bg_pill_orange_soft"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/RowIcon"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/orange"
                                android:src="@drawable/ic_bell"
                                android:tint="@android:color/white" />

                            <TextView
                                android:id="@+id/pendingText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-black"
                                android:textColor="@color/orange_ink"
                                android:textSize="17sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/openAlarm"
                            style="@style/ButtonPrimary"
                            android:text="Alarm ekranını aç" />
                    </LinearLayout>

                    <!-- Hızlı işlemler -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/todayOrders"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                style="@style/RowIcon"
                                android:layout_marginEnd="0dp"
                                android:layout_marginBottom="12dp"
                                android:src="@drawable/ic_receipt" />

                            <TextView
                                style="@style/RowTitle"
                                android:text="Bugünün siparişleri" />

                            <TextView
                                style="@style/RowSubtitle"
                                android:text="Özet, yola çıktı, teslim edildi" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/testAlarm"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                style="@style/RowIcon"
                                android:layout_marginEnd="0dp"
                                android:layout_marginBottom="12dp"
                                android:background="@drawable/bg_pill_orange_soft"
                                android:src="@drawable/ic_bell"
                                android:tint="@color/orange_ink" />

                            <TextView
                                style="@style/RowTitle"
                                android:text="Test alarmı" />

                            <TextView
                                style="@style/RowSubtitle"
                                android:text="10 sn sonra çalar, telefonu kilitleyin" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- İzinler -->
                    <TextView
                        style="@style/SectionTitle"
                        android:text="Kesintisiz çalışma" />

                    <LinearLayout style="@style/Card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="sans-serif-medium"
                                android:text="Telefon ayarları"
                                android:textColor="@color/ink"
                                android:textSize="17sp" />

                            <TextView
                                android:id="@+id/permissionCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_green_soft"
                                android:fontFamily="sans-serif-medium"
                                android:paddingStart="10dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="3dp"
                                android:textColor="@color/green_dark"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/permissionProgress"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="12dp"
                            android:progressDrawable="@drawable/progress_green" />

                        <TextView
                            android:id="@+id/permissionSummary"
                            style="@style/Body"
                            android:layout_marginTop="10dp"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:id="@+id/permissions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- Alarm ayarları -->
                    <TextView
                        style="@style/SectionTitle"
                        android:text="Alarm" />

                    <LinearLayout style="@style/Card">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/RowIcon"
                                android:src="@drawable/ic_bell" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/RowTitle"
                                    android:text="Alarm sesi" />

                                <TextView
                                    android:id="@+id/soundName"
                                    style="@style/RowSubtitle" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/changeSound"
                                style="@style/ButtonSmall"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_button_call"
                                android:text="Değiştir"
                                android:textColor="@color/green_dark" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/RowIcon"
                                android:src="@drawable/ic_volume" />

                            <Switch
                                android:id="@+id/maxVolume"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:text="Sesi en yükseğe çıkar"
                                android:textColor="@color/ink"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/RowIcon"
                                android:src="@drawable/ic_vibration" />

                            <Switch
                                android:id="@+id/vibrate"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:text="Titreşim"
                                android:textColor="@color/ink"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/RowIcon"
                                android:src="@drawable/ic_voice" />

                            <Switch
                                android:id="@+id/speak"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:text="Siparişi sesli oku"
                                android:textColor="@color/ink"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/speakNote"
                            style="@style/Body"
                            android:layout_marginStart="52dp"
                            android:textColor="@color/orange_ink"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/RowIcon"
                                android:src="@drawable/ic_flash" />

                            <Switch
                                android:id="@+id/flash"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:minHeight="48dp"
                                android:text="Flaş ışığı yanıp sönsün"
                                android:textColor="@color/ink"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Son onaylar -->
                    <TextView
                        style="@style/SectionTitle"
                        android:text="Bu telefondaki son onaylar" />

                    <LinearLayout style="@style/Card">

                        <LinearLayout
                            android:id="@+id/history"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/logout"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_button_danger"
                        android:drawableStart="@drawable/ic_logout"
                        android:drawablePadding="10dp"
                        android:drawableTint="@color/red"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Çıkış yap · bu telefonda alarmı kapat"
                        android:textColor="@color/red"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/version"
                        style="@style/Body"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:textColor="@color/subtle"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.benimmarketim.siparisalarm.MaxWidthLinearLayout>
        </FrameLayout>
    </ScrollView>
</LinearLayout>
