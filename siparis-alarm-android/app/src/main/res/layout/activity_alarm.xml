<?xml version="1.0" encoding="utf-8"?>
<!-- Yeni sipariş ekranı (dikey). Yatay düzen: layout-land/activity_alarm.xml (aynı kimlikler). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_alarm"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_orange"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.06"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="YENİ SİPARİŞ"
                android:textColor="@color/green_deep"
                android:textSize="13sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_counter"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/alarm_pulse"
                android:layout_height="@dimen/alarm_pulse"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="8dp">

                <com.benimmarketim.siparisalarm.PulseView
                    android:id="@+id/pulse"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/bell"
                    android:layout_width="@dimen/alarm_bell"
                    android:layout_height="@dimen/alarm_bell"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/lime"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    android:src="@drawable/ic_bell"
                    android:tint="@color/green_deep" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@android:color/white"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:textColor="@color/lime"
                    android:textSize="38sp" />

                <TextView
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/white_70"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/waiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_counter"
            android:drawableStart="@drawable/ic_clock"
            android:drawablePadding="6dp"
            android:drawableTint="@color/lime"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdgeLength="24dp"
        android:requiresFadingEdge="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <com.benimmarketim.siparisalarm.MaxWidthLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_alarm_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="4dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp"
                android:tag="max:640">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/RowIcon"
                        android:src="@drawable/ic_person" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/customer"
                            style="@style/RowTitle"
                            android:fontFamily="sans-serif-black"
                            android:textSize="19sp" />

                        <TextView
                            android:id="@+id/phone"
                            style="@style/RowSubtitle"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/call"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_button_call"
                        android:drawableStart="@drawable/ic_phone"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/green_dark"
                        android:minWidth="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="16dp"
                        android:stateListAnimator="@null"
                        android:text="Ara"
                        android:textAllCaps="false"
                        android:textColor="@color/green_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/RowIcon"
                        android:src="@drawable/ic_place" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowSubtitle"
                            android:text="Teslimat adresi" />

                        <TextView
                            android:id="@+id/address"
                            style="@style/RowTitle"
                            android:textSize="17sp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/RowIcon"
                        android:src="@drawable/ic_wallet" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/RowSubtitle"
                            android:text="Ödeme yöntemi" />

                        <TextView
                            android:id="@+id/payment"
                            style="@style/RowTitle"
                            android:textSize="17sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/noteLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill_orange_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        style="@style/RowIcon"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/surface"
                        android:src="@drawable/ic_note"
                        android:tint="@color/orange_ink" />

                    <TextView
                        android:id="@+id/note"
                        style="@style/Body"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/orange_ink" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/line" />

                <TextView
                    android:id="@+id/productsTitle"
                    style="@style/SectionTitle"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="14dp" />

                <LinearLayout
                    android:id="@+id/products"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:id="@+id/totals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.benimmarketim.siparisalarm.MaxWidthLinearLayout>
        </FrameLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.benimmarketim.siparisalarm.MaxWidthLinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:tag="max:640">

            <Button
                android:id="@+id/accept"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_button_accept"
                android:elevation="6dp"
                android:fontFamily="sans-serif-black"
                android:stateListAnimator="@null"
                android:text="✓  Kabul Et"
                android:textAllCaps="false"
                android:textColor="@color/green_deep"
                android:textSize="22sp" />

            <Button
                android:id="@+id/acceptAll"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_seen"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/lime"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/seen"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_button_seen"
                android:stateListAnimator="@null"
                android:text="Siparişi Gördüm"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </com.benimmarketim.siparisalarm.MaxWidthLinearLayout>
    </FrameLayout>
</LinearLayout>
